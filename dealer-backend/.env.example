# Postgres connection string. Your host / managed DB provider gives you this.
DATABASE_URL=postgres://user:password@host:5432/database
# Set to true if your provider requires SSL with a self-signed/managed cert.
DATABASE_SSL=false

# Long random string — used to sign agent session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of origins allowed to call this API (the static
# site's real domain, plus http://localhost:8901 for local dev).
ALLOWED_ORIGINS=https://silverwind.website,http://localhost:8901

PORT=4100
NODE_ENV=development
